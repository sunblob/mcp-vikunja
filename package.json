{
  "name": "@fswap/mcp-vikunja",
  "version": "0.1.10",
  "description": "MCP server for Vikunja — manage tasks, assignees, comments, attachments, relations and kanban from Claude",
  "type": "module",
  "bin": {
    "mcp-vikunja": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "npm run build && node test/smoke.test.mjs && node --test test/install.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "start": "node dist/index.js",
    "setup": "node dist/index.js setup",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "env-paths": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0"
  },
  "keywords": [
    "mcp",
    "vikunja",
    "tasks",
    "todo",
    "claude",
    "modelcontextprotocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunblob/mcp-vikunja.git"
  },
  "homepage": "https://github.com/sunblob/mcp-vikunja#readme",
  "bugs": {
    "url": "https://github.com/sunblob/mcp-vikunja/issues"
  }
}
